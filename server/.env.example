# Copy to .env for local development. Never commit the real .env.
PORT=5000
NODE_ENV=development
# Leave MONGO_URI empty locally to use an in-memory database.
# Production (Atlas): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/techfest?retryWrites=true&w=majority
MONGO_URI=
JWT_SECRET=replace-with-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
